# VAPID Keys for Push Notifications
# Generate these using: npx web-push generate-vapid-keys
REACT_APP_VAPID_PUBLIC_KEY=your_public_key_here
REACT_APP_VAPID_PRIVATE_KEY=your_private_key_here
REACT_APP_VAPID_SUBJECT=mailto:your-email@example.com

# Node.js Configuration
NODE_ENV=development
PORT=4356
